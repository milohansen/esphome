#!/usr/bin/env bash
# Set up ESPHome dev environment

set -e

cd "$(dirname "$0")/.."
if [ ! -n "$VIRTUAL_ENV" ]; then
  if [ -x "$(command -v uv)" ]; then
    uv venv --seed venv
  else
    python3 -m venv venv
  fi
  source venv/bin/activate
fi

if ! [ -x "$(command -v uv)" ]; then
  python3 -m pip install uv
fi

uv pip install setuptools wheel
uv pip install -e ".[dev,test]" --config-settings editable_mode=compat

pre-commit install

mkdir -p .temp

# Rust setup for hybrid architecture
if [ -x "$(command -v rustup)" ]; then
  echo "Setting up Rust environment..."
  rustup target add riscv32imc-unknown-none-elf
  if ! [ -x "$(command -v espflash)" ]; then
    echo "Installing espflash..."
    cargo install espflash
  fi
  # Check for libclang
  if ! [ -f /usr/lib/x86_64-linux-gnu/libclang.so ] && ! [ -f /usr/lib/libclang.so ] && ! [ -x "$(command -v llvm-config)" ]; then
    echo "Warning: libclang not found. bindgen (used in Rust migration) might fail."
    echo "On Ubuntu/Debian, try: sudo apt install libclang-dev"
  fi
else
  echo "Warning: rustup not found. Rust components will not be buildable."
  echo "Please install Rust from https://rustup.rs/"
fi

echo
echo
echo "Virtual environment created. Run 'source venv/bin/activate' to use it."
